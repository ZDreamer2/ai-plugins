#!/usr/bin/env python3
"""Check this marketplace's routed Python and JSON syntax without source execution.

This concrete entry reuses the marketplace validator; it does not run unit tests,
build distributions or establish installed-host acceptance.
"""

import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / 'ai-marketplace' / 'scripts'))

from marketplace.validation import check_syntax


def main() -> int:
    try:
        result = check_syntax(json.load(sys.stdin))
    except (OSError, KeyError, TypeError, ValueError) as error:
        print(f'on-diff-check: {error}', file=sys.stderr)
        return 1
    json.dump(result, sys.stdout)
    sys.stdout.write('\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
